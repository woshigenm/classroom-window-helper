# Normalize line endings in the repository.
* text=auto

# Windows entry scripts: CRLF on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# C sources / docs / Makefiles: LF on checkout.
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
Makefile text eol=lf
*.mk text eol=lf

# Binary artifacts (also ignored by .gitignore, but keep the rule).
*.exe binary
*.dll binary
*.lib binary
*.png binary
*.jpg binary
*.zip binary
